+def relative_squared_error(
+    label: jnp.array,
+    prediction: jnp.array,
+    name: str,
+    parameters: dict = {},
+    inputs: dict = {},
+) -> jnp.array:
+    """Squared error relative to the per-atom reference magnitude:
+    ((pred - label) / (eps + |label_atom|))^2, eps (default 0.1, in the property's units) keeps
+    small-force atoms from dominating. Padded atoms have zero label and prediction, so they add 0."""
+    label, prediction = label[name], prediction[name]
+    eps = parameters.get("eps", 0.1)
+    norm = jnp.linalg.norm(label, axis=-1, keepdims=True)
+    return ((label - prediction) / (eps + norm)) ** 2
+
